flowchart TB
    subgraph KLIENCI["Warstwa kliencka (Electron)"]
        HOST["Klient HOST\nRenderer -> Preload -> Main"]
        GUEST["Klient GUEST\nRenderer -> Preload -> Main"]
    end

    PROXY["WAF + Nginx\nTLS / reverse proxy"]

    subgraph BACKEND["Warstwa backendowa"]
        REST["API REST (/api/v1)"]
        WS["Socket.IO (/socket.io)"]
    end

    CACHE[("Redis / Valkey")]
    DB[("PostgreSQL")]
    MINIO[("MinIO")]

    subgraph EXTERNAL["Komponenty zewnetrzne"]
        TURN["coturn (VPS zewnetrzny)\nSTUN/TURN"]
    end

    HOST -->|"HTTPS"| PROXY
    GUEST -->|"HTTPS"| PROXY
    PROXY --> REST

    HOST -->|"WSS"| PROXY
    GUEST -->|"WSS"| PROXY
    PROXY --> WS

    REST --> CACHE
    WS --> CACHE
    REST --> DB
    REST --> MINIO

    HOST <-. "WebRTC P2P (obraz/sterowanie)" .-> GUEST
    HOST -. "ICE fallback (publiczny TURN)" .-> TURN
    GUEST -. "ICE fallback (publiczny TURN)" .-> TURN

    subgraph LEGENDA["Legenda"]
        L1["Linie ciągłe: komunikacja przez backend (HTTPS/WSS)"]
        L2["Linie kropkowane: kanał WebRTC i TURN"]
    end

    classDef client fill:#e8f0ff,stroke:#2f5aa8,stroke-width:1.5px;
    classDef edge fill:#fff7e6,stroke:#9a6700,stroke-width:1.5px;
    classDef backend fill:#e9f9ef,stroke:#2f8f4e,stroke-width:1.5px;
    classDef infra fill:#f4ecff,stroke:#6b3fa0,stroke-width:1.5px;
    classDef note fill:#f8f8f8,stroke:#888,stroke-dasharray: 3 3;
    classDef external fill:#fff0f0,stroke:#b94a48,stroke-width:1.5px;

    class HOST,GUEST client;
    class PROXY edge;
    class REST,WS backend;
    class CACHE,DB,MINIO infra;
    class TURN external;
    class L1,L2 note;
